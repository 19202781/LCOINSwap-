# LCOINSWAP Environment Configuration
# ⚠️ NUNCA commits este archivo con datos reales a Git
# ⚠️ SIEMPRE agrega .env a .gitignore

# Solscan API Key (Obtén una gratis en https://solscan.io/register)
VITE_SOLSCAN_API_KEY=tu_clave_aqui

# Red de Solana (devnet o mainnet)
VITE_SOLANA_NETWORK=devnet

# RPC Endpoints (opcional, para usar custom RPC)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Jupiter API (sin clave requerida)
VITE_JUPITER_API=https://quote-api.jup.ag/v6

# Pump.fun API
VITE_PUMP_FUN_API=https://pump.fun/api

# CoinGecko API (sin clave requerida)
VITE_COINGECKO_API=https://api.coingecko.com/api/v3
